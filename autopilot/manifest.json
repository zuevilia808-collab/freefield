{
  "manifest_version": 3,
  "name": "Freefield Автопилот",
  "version": "0.3.0",
  "description": "Связывает сайт Freefield с Freefield на компьютере (профили Chrome, Flow, Dola, Arena, Vids) и сам делает карточки Freefield в Google Flow: открывает Flow, прикладывает фото, вставляет промпт, нажимает «Создать» и возвращает результат. Кредиты кончились — сам входит следующим аккаунтом Google.",
  "icons": {"48": "icon-48.png", "128": "icon-128.png"},
  "action": {"default_title": "Freefield Автопилот", "default_icon": {"48": "icon-48.png", "128": "icon-128.png"}},
  "background": {"service_worker": "bg.js"},
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://labs.google/*", "https://flow.google.com/*", "https://*.googleusercontent.com/*", "https://storage.googleapis.com/*"],
  "content_scripts": [
    {"matches": ["https://zuevilia808-collab.github.io/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_start"},
    {"matches": ["https://labs.google/*"], "js": ["flow.js"], "run_at": "document_idle"}
  ]
}
